# ==============================================================================
# CampusFind - Environment Configuration Example
# Salin file ini menjadi .env pada direktori root proyek (campusfind/.env)
# CATATAN: JANGAN PERNAH MENYIMPAN NILAI SECRET ASLI DI SINI ATAU DI GIT
# ==============================================================================

# Mode aplikasi: development | production | test
NODE_ENV="development"

# Port server backend API
PORT=3001

# URL koneksi database MySQL
# Format: mysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql://campusfind:campusfind@localhost:3306/campusfind"

# Secret kunci enkripsi JWT (Minimal 16 karakter acak yang kuat)
# Pada production, HARUS diganti dengan nilai rahasia unik berkekuatan tinggi
JWT_SECRET="ganti-dengan-kunci-rahasia-jwt-minimal-16-karakter"

# Durasi masa berlaku token JWT (contoh: 1h, 1d, 7d)
JWT_EXPIRES_IN="1d"

# URL frontend klien (digunakan untuk konfigurasi CORS whitelist)
# Untuk beberapa origin, pisahkan dengan koma (contoh: http://localhost:5173,http://localhost:3000)
CLIENT_URL="http://localhost:5173"

# Direktori penyimpanan lokal berkas upload gambar
UPLOAD_DIR="uploads"

# Batas ukuran berkas upload dalam MegaByte (MB)
MAX_FILE_SIZE_MB=5
