{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@campusfind/shared": [
        "../../packages/shared/src/index.ts",
        "../../packages/shared/src",
        "../../packages/shared"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/src/**/*"
  ]
}
