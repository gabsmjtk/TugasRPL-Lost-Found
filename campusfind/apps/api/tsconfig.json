{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@campusfind/shared": [
        "../../packages/shared/dist/index.d.ts",
        "../../node_modules/@campusfind/shared/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
