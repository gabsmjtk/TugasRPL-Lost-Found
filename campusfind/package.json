{
  "name": "campusfind",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspace=@campusfind/shared && npm run build --workspace=@campusfind/api && npm run build --workspace=@campusfind/web",
    "lint": "npm run lint --workspaces",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:seed": "npm run db:seed --workspace=api"
  }
}
